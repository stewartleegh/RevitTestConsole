<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- R2025+ 外壳（.NET 8）。三壳 AssemblyName 相同、bin 目录不同。 -->
    <OutputPath>$(MSBuildProjectDirectory)\bin\R2025Plus\$(Configuration)\$(TargetFramework)\</OutputPath>
    <AssemblyName>RevitTestConsole.Host</AssemblyName>
    <RootNamespace>RevitTestConsole.Host</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <DefineConstants>$(DefineConstants);R2025PLUS</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RevitTestConsole.Core\RevitTestConsole.Core.R2025Plus.csproj" />
    <ProjectReference Include="..\RevitTestConsole.TestKit\RevitTestConsole.TestKit.R2025Plus.csproj" />
    <ProjectReference Include="..\..\samples\SampleCommand.Tests\SampleCommand.Tests.R2025Plus.csproj" />
  </ItemGroup>
</Project>
